#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Only this table is replaced on reload, so Podman/netavark tables are untouched.
table inet pilab
delete table inet pilab

table inet pilab {
  set lan4 {
    type ipv4_addr
    flags interval
    elements = { {{ base_lan_cidrs_v4 | join(', ') }} }
  }
  set lan6 {
    type ipv6_addr
    flags interval
    elements = { {{ base_lan_cidrs_v6 | join(', ') }} }
  }

  chain input {
    type filter hook input priority filter; policy drop;

    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    meta l4proto { icmp, ipv6-icmp } accept

    # mDNS (pilab.local) and DHCPv6 client
    udp dport 5353 accept
    ip6 saddr fe80::/10 udp dport 546 accept

    # SSH from the LAN only
    ip saddr @lan4 tcp dport 22 accept
    ip6 saddr @lan6 tcp dport 22 accept

    # Per-role and per-host rules
    include "/etc/nftables.d/*.nft"
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
  }
}
