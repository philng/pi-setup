# {{ ansible_managed }}
# Hand newly plugged printers and webcams to the OctoPrint container
# (octoprint-replug@.service runs /usr/local/sbin/octoprint-devices).
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*|ttyUSB[0-9]*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="octoprint-replug@tty.service"
{% if octoprint_webcam_device != 'off' %}
ACTION=="add", SUBSYSTEM=="video4linux", TAG+="systemd", ENV{SYSTEMD_WANTS}+="octoprint-replug@video.service"
{% endif %}
