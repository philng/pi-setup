# {{ ansible_managed }}
# Started by /etc/udev/rules.d/70-octoprint.rules when a USB serial port or
# webcam appears. Regenerates the Quadlet unit so the new device is passed
# through, then restarts OctoPrint if it is already running.
[Unit]
Description=Pass a newly plugged printer or webcam to OctoPrint
After=user@{{ podman_user_uid }}.service

[Service]
Type=oneshot
ExecStart=-/usr/bin/systemctl --user -M {{ podman_user }}@ daemon-reload
ExecStart=-/usr/bin/systemctl --user -M {{ podman_user }}@ try-restart octoprint.service
