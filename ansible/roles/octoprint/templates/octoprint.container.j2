# {{ ansible_managed }}
# Rootless OctoPrint, generated into octoprint.service by Quadlet.
[Unit]
Description=OctoPrint

[Container]
ContainerName=octoprint
Image={{ octoprint_image }}
AutoUpdate=registry
# IPv4 only: haproxy in the image listens on IPv4 only, so a forwarded IPv6
# connection would be accepted by pasta and then reset. Unbound, IPv6
# clients get "refused" and fall back to IPv4 at once.
PublishPort=0.0.0.0:{{ octoprint_port }}:80
Volume={{ octoprint_data_dir }}:/octoprint
# Keep the host user's dialout/video groups inside the container (needs crun).
PodmanArgs=--group-add keep-groups
# The printer and webcam (AddDevice, mjpg-streamer settings) are in
# octoprint.container.d/50-devices.conf, written by octoprint-devices.

[Service]
Restart=always
RestartSec=10
# First start may pull a large image on a Pi.
TimeoutStartSec=900

[Install]
WantedBy=default.target
