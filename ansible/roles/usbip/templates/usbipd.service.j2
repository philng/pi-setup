# {{ ansible_managed }}
[Unit]
Description=USB/IP server daemon
After=network-online.target systemd-modules-load.service
Wants=network-online.target
# Never alongside VirtualHere (the virtualhere role), which shares the same dongles.
Conflicts=virtualhere.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe usbip_host
ExecStart=/usr/sbin/usbipd --tcp-port {{ usbip_port }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
