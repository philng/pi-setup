# Settings baked into the first-boot config by scripts/configure-boot.sh.
# Nothing in here is secret: login is SSH-key only, there is no password.
PI_HOSTNAME=pilab
PI_USER=admin
PI_TIMEZONE=America/Los_Angeles
PI_KEYBOARD=us
# Public key that will be allowed to log in. Override on the command line:
#   SSH_PUBKEY_FILE=~/.ssh/other.pub scripts/configure-boot.sh /run/media/$USER/bootfs
SSH_PUBKEY_FILE=${SSH_PUBKEY_FILE:-$HOME/.ssh/id_ed25519.pub}
