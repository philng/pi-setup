# Settings baked into the first-boot config by scripts/configure-boot.sh.
# Nothing in here is secret: login is SSH-key only, there is no password.
# Easiest: run `make new-pi`, which asks for the hostname and key and passes them.
# The login user is not here: it is ansible_user in
# ansible/inventory/group_vars/pis.yml, so the Pi and Ansible always agree.
# Hostname: one per Pi, matching ansible/inventory/hosts.yml (pilab-living, pilab-rack, octopi).
# Override per run: PI_HOSTNAME=octopi scripts/configure-boot.sh ...
PI_HOSTNAME=${PI_HOSTNAME:-pilab-living}
# Timezone and keyboard are Ansible's: base_timezone and base_keyboard_layout
# in ansible/roles/base/defaults/main.yml.
# Wi-Fi is optional and off unless you ask (configure-boot.sh / make new-pi ask).
# This is only the default country for it; the network name and password are
# typed in when asked and never stored in the repo.
PI_WIFI_COUNTRY=${PI_WIFI_COUNTRY:-US}
# Public key that will be allowed to log in. Override on the command line:
#   SSH_PUBKEY_FILE=~/.ssh/other.pub scripts/configure-boot.sh /run/media/$USER/bootfs
SSH_PUBKEY_FILE=${SSH_PUBKEY_FILE:-$HOME/.ssh/id_ed25519.pub}
