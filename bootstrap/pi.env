# Settings baked into the first-boot config by scripts/flash.sh.
# Nothing in here is secret: login is SSH-key only, there is no password.
PI_HOSTNAME=pilab
PI_USER=admin
PI_TIMEZONE=America/Los_Angeles
PI_KEYBOARD=us
# Public key that will be allowed to log in. Override on the command line:
#   sudo SSH_PUBKEY_FILE=~/.ssh/other.pub scripts/flash.sh /dev/sdX
SSH_PUBKEY_FILE=${SSH_PUBKEY_FILE:-$HOME/.ssh/id_ed25519.pub}
# Pin an exact image for reproducibility, or leave as "latest".
# Example of a pinned URL:
#   https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2025-11-24/2025-11-24-raspios-trixie-arm64-lite.img.xz
PI_IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64_latest
