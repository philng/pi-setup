#cloud-config
# Rendered by scripts/configure-boot.sh. @VARS@ come from bootstrap/pi.env,
# except @PI_USER@: ansible_user in ansible/inventory/group_vars/pis.yml.
#
# First boot only, and only what it takes to reach the Pi over SSH: its name,
# the login user and key, and the network. The Ansible base role re-applies all
# of it (and the timezone, keyboard, sudo, SSH hardening) on every make apply,
# then turns cloud-init off, so change settings there, not here.
hostname: @PI_HOSTNAME@
manage_etc_hosts: true

# Raspberry Pi OS specific: turn on the SSH server.
enable_ssh: true
ssh_pwauth: false

users:
  - name: @PI_USER@
    groups: users,adm,dialout,audio,netdev,video,plugdev,input,gpio,render,sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - @SSH_PUBKEY@

# Ansible needs Python, which Pi OS Lite already ships.
package_update: false
