#!/usr/bin/env bash
# Keep every USB device exported by a USB/IP server attached to this machine.
#
#   usbip-autoattach pilab          # loop forever (what the service runs)
#   usbip-autoattach --once pilab   # one pass, then exit
#   usbip-autoattach --detach-all         # give every attached device back
#
# The Pi only exports the dongles you chose, and a device that's already
# attached somewhere disappears from the export list. So "attach whatever is
# exportable" is all that's needed. It also covers replugging a dongle, a Pi
# reboot and network drops: the next pass picks the device up again.
set -uo pipefail

USBIP=${USBIP_BIN:-usbip}
INTERVAL=${INTERVAL:-5}
log() { echo "usbip-autoattach: $*"; }

if [[ ${1:-} == --detach-all ]]; then
  # "Port 00: <Port in Use> ..." -> 00
  for port in $("$USBIP" port 2>/dev/null | sed -nE 's/^Port ([0-9]+): <Port in Use>.*/\1/p'); do
    "$USBIP" detach -p "$port" && log "detached port $port"
  done
  exit 0
fi

once=false
if [[ ${1:-} == --once ]]; then once=true; shift; fi
SERVER=${1:-${SERVER:-}}
[[ -n $SERVER ]] || { echo "usage: $0 [--once] SERVER | --detach-all" >&2; exit 2; }

exportable() {
  # Lines look like "      1-1.3: Valve Software : unknown product (28de:1142)"
  "$USBIP" list -r "$SERVER" 2>/dev/null | sed -nE 's/^[[:space:]]+([0-9]+-[0-9.]+): .*/\1/p'
}

pass() {
  local busid
  for busid in $(exportable); do
    if "$USBIP" attach -r "$SERVER" -b "$busid"; then
      log "attached $SERVER:$busid"
    else
      log "could not attach $SERVER:$busid (will retry)"
    fi
  done
}

if $once; then pass; exit 0; fi

log "watching $SERVER every ${INTERVAL}s"
while true; do
  pass
  sleep "$INTERVAL"
done
